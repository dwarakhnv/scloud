# Copy this file to .env (docker compose loads .env automatically) and
# adjust as needed. .env is gitignored since it can hold secrets.

# Port SCloud listens on, both inside the container and published on the
# host (i.e. http://localhost:5125). Point a reverse proxy or a Cloudflare
# Tunnel (cloudflared) at this same port to expose the site publicly -
# see docs/windows-setup.md / docs/linux-setup.md for an example.
SCLOUD_PORT=5125

# Where your files/thumbnails live. Defaults to ./data next to this file.
# This one is safe to point at a portable drive you move between Windows and
# Linux (format it exFAT for that) - see docs/external-drive.md. No rebuild
# needed to change it, just: docker compose down && docker compose up -d
SCLOUD_DATA_DIR=./data

# Where the sqlite database lives. Deliberately SEPARATE from SCLOUD_DATA_DIR
# above and defaults to its own ./db folder. Keep this on local, native
# storage - do NOT point it at the same portable/cross-platform drive as
# SCLOUD_DATA_DIR. SQLite needs real file locking to stay consistent, which
# exFAT/removable media don't reliably provide; a corrupted database is much
# worse than losing a drive of already-uploaded files. See docs/external-drive.md.
SCLOUD_DB_DIR=./db

# Same idea for the config directory (holds config/config.env) - fine to
# leave local too.
SCLOUD_CONFIG_DIR=./config

# Optional: create this admin account automatically the first time the
# container starts (leave blank to create one yourself later with
# `docker compose exec app python manage.py createsuperuser`).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Gunicorn tuning - defaults are fine for most home/small-team setups.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=600
