# SCloud configuration
# Paths are resolved relative to this file's directory unless absolute.
#
# This file is committed as a template. The real config/config.env is
# gitignored (it holds your secret key and, potentially, mail credentials).
# When running via Docker, the entrypoint script copies this file to
# config/config.env automatically on first run and fills in a random
# SECRET_KEY - you normally don't need to do this by hand.

# Root folder that holds all user/group data (files + thumbnails).
# Inside the Docker container this should stay "../data" - to actually store
# data on a different disk (including a portable external drive you move
# between Windows and Linux), change SCLOUD_DATA_DIR in .env instead, which
# controls what host path gets mounted to /app/data. See docs/external-drive.md.
DATA_ROOT=../data

# Sqlite database file location. Deliberately a SEPARATE path from DATA_ROOT,
# defaulting to its own "../db" directory rather than living inside "../data".
# SQLite needs real, reliable file locking to stay consistent - which is
# exactly what's missing or flaky on removable/cross-platform-formatted
# drives (exFAT has no POSIX locking at all; NTFS-via-ntfs-3g on Linux is
# unreliable for it too). If you move DATA_ROOT to a portable drive you plan
# to plug into both Windows and Linux, leave DATABASE_PATH pointing at local,
# native storage on whichever machine is actually running the app - use
# SCLOUD_DB_DIR in .env for that, not this DATA_ROOT/SCLOUD_DATA_DIR pair.
DATABASE_PATH=../db/database.db

# Django secret key - change this in production (the Docker entrypoint
# generates a random one automatically if left as the placeholder below).
SECRET_KEY=change-me-super-secret-key-please

# Set to False in production
DEBUG=True

# Comma separated list of allowed hosts. Set this to your real domain(s)/IP
# in production, e.g. ALLOWED_HOSTS=scloud.example.com,192.168.1.50
ALLOWED_HOSTS=*

# Max upload size in MB (per file). 10 GB by default - large video files are
# sent from the browser in chunks (see UPLOAD_CHUNK_SIZE_MB) so this is safe.
MAX_UPLOAD_SIZE_MB=10240

# Size of each chunk the browser sends for large uploads. Smaller chunks are
# more resilient to flaky mobile connections (only the failed chunk retries).
UPLOAD_CHUNK_SIZE_MB=8

# Thumbnail size (long edge, in pixels)
THUMBNAIL_SIZE=256

# --- Outgoing email (for "forgot password" reset links) -----------------
# Example using a Gmail address with an app password:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-char-app-password
#   EMAIL_USE_TLS=True
#   DEFAULT_FROM_EMAIL=SCloud <you@gmail.com>
# Leave EMAIL_HOST blank to print reset emails to the console/logs instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SCloud <noreply@scloud.local>
